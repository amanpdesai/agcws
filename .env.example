# Copy to .env for local runs. Do not commit .env or credentials.
AGCWS_VERILATOR=verilator
AGCWS_YOSYS=yosys
AGCWS_OPENSTA=sta
AGCWS_IVERILOG=iverilog
AGCWS_LIBERTY=
AGCWS_ARTIFACT_ROOT=out

# Vertex AI configuration is supplied by the runtime/secret manager.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
