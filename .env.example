# Copy to .env for host-specific tool overrides. Relative paths are repo-relative.
AGCWS_VERILATOR=verilator
AGCWS_YOSYS=yosys
AGCWS_OPENSTA=sta
AGCWS_VCD2SAIF=vcd2saif
AGCWS_IVERILOG=iverilog
# Required for the full OpenTitan AES synthesis source; leave empty when using
# a frontend that cannot parse the design.
AGCWS_SLANG_PLUGIN=
AGCWS_LIBERTY=third_party/liberty/sky130hd/sky130_fd_sc_hd__tt_025C_1v80.lib
AGCWS_LIBERTY_NANGATE45=third_party/liberty/nangate45/Nangate45_typ.lib
AGCWS_ARTIFACT_ROOT=out
