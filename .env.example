# Copy to .env for host-specific tool overrides. Relative paths are repo-relative.
AGCWS_VERILATOR=verilator
AGCWS_YOSYS=yosys
AGCWS_OPENSTA=sta
AGCWS_VCD2SAIF=vcd2saif
AGCWS_IVERILOG=iverilog
AGCWS_VVP=vvp
AGCWS_IVERILOG_VPI=iverilog-vpi
# Optional coupled-DMA reference support; defaults to the active venv layout.
AGCWS_MYHDL_DIR=.venv/share/myhdl/cosimulation/icarus
# Required for the full OpenTitan AES synthesis source. Docker supplies this
# path; set the host-specific equivalent when running outside Docker.
AGCWS_SLANG_PLUGIN=
AGCWS_LIBERTY=third_party/liberty/sky130hd/sky130_fd_sc_hd__tt_025C_1v80.lib
AGCWS_LIBERTY_NANGATE45=third_party/liberty/nangate45/Nangate45_typ.lib
AGCWS_ARTIFACT_ROOT=out
# Optional authoritative AES calibration record for baseline runs.
AGCWS_CALIBRATION=out/calibration-input/calibration.json
# Required only for --policy vertex; use the exact model identifier returned by Vertex.
AGCWS_GCP_PROJECT=
AGCWS_GEMINI_MODEL=
